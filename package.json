{
  "name": "xunzhi-pdf-editor",
  "version": "0.6.0",
  "description": "Xunzhi PDF Editor - Electron + Vite + React + TypeScript desktop app",
  "private": true,
  "main": "dist-electron/main.js",
  "productName": "Xunzhi PDF Editor",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dev:electron": "npm run build:electron && vite build && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build && npm run build:electron",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.xunzhi.pdfeditor",
    "productName": "Xunzhi PDF Editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
